{
  "name": "salestore-responsive-tests",
  "version": "1.0.0",
  "description": "Responsive behavior tests for SaleStore Bootstrap migration",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:responsive": "playwright test tests/responsive-breakpoints.spec.js"
    ,"test:critical": "playwright test tests/critical-demo.spec.js --workers=1 --reporter=line"
    ,"test:extended": "playwright test --grep-invert \"critical recruiter/demo flows\" --workers=1 --reporter=line"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.40.0"
  }
}
